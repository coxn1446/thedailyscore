{
  "name": "thedailyscore",
  "version": "0.1.0",
  "private": true,
  "description": "The Daily Score — paste a daily-game result and publish it to the groups that track that game.",
  "main": "serverIndex.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node serverIndex.js",
    "dev": "concurrently -n server,client -c blue,green \"npm run server:dev\" \"npm run start:dev\"",
    "start:dev": "vite",
    "server:dev": "nodemon serverIndex.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "db:migrate": "node scripts/db-migrate.js",
    "s:prod": "CAP_APP_ENV=prod npx cap sync ios && CAP_APP_ENV=prod node scripts/sync-ios-bundle-settings.js",
    "s:qa": "CAP_APP_ENV=qa npx cap sync ios && CAP_APP_ENV=qa node scripts/sync-ios-bundle-settings.js",
    "s:dev": "CAP_APP_ENV=dev npx cap sync ios && CAP_APP_ENV=dev node scripts/sync-ios-bundle-settings.js",
    "s": "npm run s:dev"
  },
  "nodemonConfig": {
    "watch": [
      "serverIndex.js",
      "server/"
    ],
    "ignore": [
      "build/",
      "src/"
    ],
    "ext": "js,json"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/device": "^7.0.0",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.0",
    "@google-cloud/secret-manager": "^6.0.0",
    "@google-cloud/storage": "^7.0.0",
    "@ionic/react": "^8.0.0",
    "@reduxjs/toolkit": "^2.0.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.0",
    "firebase-admin": "^13.0.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.13",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.0",
    "react-redux": "^9.0.0",
    "react-router-dom": "^7.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.28.0",
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^4.5.0",
    "babel-jest": "^30.0.0",
    "concurrently": "^9.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "nodemon": "^3.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.0.0"
  }
}
