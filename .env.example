# --- Server ---
NODE_ENV=development
PORT=8080
SESSION_SECRET=dev-session-secret-change-me
DEFAULT_CLIENT_URL=http://localhost:3000

# --- Database (local PostgreSQL) ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=thedailyscore
DB_HOST=localhost
DB_PORT=5432
# Cloud only: DB_SCHEMA=qa|prod
# DB_SCHEMA=
# INSTANCE_CONNECTION_NAME=nash-data:northamerica-northeast1:shared-pg

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple Sign In ---
# The Continue with Apple button only appears when all four values are set.
# QA Services ID is site.thedailyscore.thedailyscore. Prod is site.thedailyscore.app.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_KEY=

# --- Stripe (installed, unwired) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Email (optional) ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# --- Firebase (admin JSON for project thedailyscore-cea9b; Cloud Run loads this from Secret Manager) ---
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Google Cloud (QA/prod) ---
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_STORAGE_BUCKET=

# --- Capacitor sync URLs (optional) ---
# CAP_PROD_URL=https://thedailyscore.site
# CAP_QA_URL=https://qa.thedailyscore.site
# Dev iOS live-reload. Defaults to http://192.168.1.171:3000
# CAP_DEV_URL=http://192.168.1.171:3000
