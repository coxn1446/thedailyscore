# --- Server ---
NODE_ENV=development
PORT=8080
SESSION_SECRET=dev-session-secret-change-me
DEFAULT_CLIENT_URL=http://localhost:3000

# --- Database (local PostgreSQL) ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=thedailyscore
DB_HOST=localhost
DB_PORT=5432
# Cloud only: DB_SCHEMA=qa|prod
# DB_SCHEMA=
# INSTANCE_CONNECTION_NAME=nash-data:northamerica-northeast1:shared-pg

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple Sign In (leave unset until the Services ID is ready) ---
# The Continue with Apple button only appears when all four values are set.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_KEY=

# --- Stripe (installed, unwired) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Email (optional) ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# --- Firebase (push stays inert until a later prompt) ---
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Google Cloud (QA/prod) ---
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_STORAGE_BUCKET=

# --- Capacitor sync URLs (optional) ---
# CAP_PROD_URL=https://thedailyscore.com
# CAP_QA_URL=https://qa.thedailyscore.com
# Dev defaults to the Mac LAN IP (http://<lan-ip>:3000). Set this to force localhost or a tunnel:
# CAP_DEV_URL=http://localhost:3000
